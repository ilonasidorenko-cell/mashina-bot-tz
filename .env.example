# Скопируйте в /etc/solaris/llm.env, заполните своими ключами и закройте: chmod 600
# Файл с ключами не должен лежать внутри каталога проекта и не должен попадать в git.

# Телеграм-бот
TG_BOT_TOKEN=
ALERT_CHAT_ID=

# Основной канал: официальный CLI Claude Code.
# Если у вас подписка Claude Max, вход делается командой claude login, и переменная ниже не нужна.
# Если подписки нет, основным каналом будет роутер или прямой ключ, CLI настраивается на него.
CLAUDE_CLI=claude
CLAUDE_MODEL=claude-opus-5
# CLAUDE_CODE_OAUTH_TOKEN=   # только если входите токеном подписки

# Резервная цепочка
ROUTER_API_KEY=
ROUTER_MODEL=claude-sonnet-4-6
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
